<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Gustavo Ayres</Authors>
    <Product>Gibi-o-matic</Product>
    <Copyright>Copyright (c) 2026 Gustavo Ayres</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- MinVer: tag "v0.5.0" builds 0.5.0; later commits build 0.5.1-alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Before the first tag: 0.1.0-alpha.0.N (the installer refuses 0.0.0). -->
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
</Project>
