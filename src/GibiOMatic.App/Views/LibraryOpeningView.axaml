<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GibiOMatic.App.ViewModels"
             xmlns:r="using:GibiOMatic.App.Resources"
             x:Class="GibiOMatic.App.Views.LibraryOpeningView"
             x:DataType="vm:LibraryOpeningViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="560" Margin="32,64" Spacing="20" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Image Source="/Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Classes="brand" FontSize="26" Text="Gibi-o-matic" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Opening (and the slow warning, which keeps the progress bar) -->
      <StackPanel Spacing="10" IsVisible="{Binding !HasError}">
        <TextBlock Classes="h2" Text="{x:Static r:Strings.Opening_Title}" IsVisible="{Binding IsOpening}" TextWrapping="Wrap" />
        <TextBlock Classes="h2" Text="{x:Static r:Strings.Opening_Slow}" IsVisible="{Binding IsSlow}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Path}" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" Height="4" MaxWidth="360" HorizontalAlignment="Left" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Spacing="14" IsVisible="{Binding IsSlow}">
        <TextBlock Classes="help" Text="{x:Static r:Strings.Opening_SlowHelp}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{x:Static r:Strings.Opening_KeepWaiting}" Command="{Binding KeepWaitingCommand}" />
          <Button Classes="secondary" Content="{x:Static r:Strings.Opening_ChooseAnother}" Command="{Binding ChooseAnotherCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Failed: nothing retries by itself -->
      <StackPanel Spacing="14" IsVisible="{Binding HasError}">
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{x:Static r:Strings.Opening_Retry}" Command="{Binding RetryCommand}" />
          <Button Classes="secondary" Content="{x:Static r:Strings.Opening_ChooseAnother}" Command="{Binding ChooseAnotherCommand}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
