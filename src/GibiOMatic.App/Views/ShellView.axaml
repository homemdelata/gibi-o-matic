<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GibiOMatic.App.ViewModels"
             xmlns:c="using:GibiOMatic.App.Controls"
             xmlns:conv="using:GibiOMatic.App.Converters"
             xmlns:r="using:GibiOMatic.App.Resources"
             xmlns:svc="using:GibiOMatic.App.Services"
             x:Class="GibiOMatic.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Width="{StaticResource SidebarWidth}" ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Panel>
        <Border Classes="halftone sidebar" />
        <DockPanel Margin="16,24">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,0,6,22">
            <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Classes="brand" Text="Gibi-o-matic" VerticalAlignment="Center" />
          </StackPanel>

          <!-- The version, under everything: which build this is -->
          <StackPanel DockPanel.Dock="Bottom" Margin="6,10,6,0" Background="Transparent" ToolTip.Tip="{x:Static vm:UpdateStatusViewModel.BuildText}">
            <TextBlock Classes="mono muted" FontSize="11" TextTrimming="CharacterEllipsis" Text="{x:Static svc:AppInfo.Version}" />
            <TextBlock Classes="mono muted" FontSize="11" TextTrimming="CharacterEllipsis" Text="{x:Static vm:UpdateStatusViewModel.BuildLine}"
                       IsVisible="{x:Static vm:UpdateStatusViewModel.HasBuildLine}" />
          </StackPanel>

          <!-- Status of the archive and of each destination -->
          <Border DockPanel.Dock="Bottom" Padding="14" CornerRadius="{StaticResource RadiusCard}"
                  Background="{DynamicResource BgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource BorderControl}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="8,0,10,0" FontSize="12" FontWeight="Medium"
                           Text="{x:Static r:Strings.Status_Archive}" />
                <TextBlock Grid.Column="2" Classes="mono muted" FontSize="12" HorizontalAlignment="Right"
                           TextTrimming="PrefixCharacterEllipsis"
                           Text="{Binding LibraryPath}" ToolTip.Tip="{Binding LibraryPath}" />
              </Grid>
              <!-- Background work: inbox and metadata search -->
              <Button Classes="status-line" Command="{Binding Activity.OpenInboxCommand}" IsVisible="{Binding Activity.ShowInbox}"
                      ToolTip.Tip="{Binding Activity.InboxDetail}" AutomationProperties.Name="{x:Static r:Strings.Nav_Inbox}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding Activity.InboxKind, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=Fill}" />
                    <TextBlock Grid.Column="1" Margin="8,0,10,0" FontSize="12" FontWeight="Medium" Text="{x:Static r:Strings.Nav_Inbox}" />
                    <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding Activity.InboxText}" />
                  </Grid>
                  <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Activity.InboxProgress}"
                               IsVisible="{Binding Activity.InboxRunning}" />
                </StackPanel>
              </Button>
              <Button Classes="status-line" Command="{Binding Activity.OpenReviewCommand}" IsVisible="{Binding Activity.ShowMetadata}"
                      ToolTip.Tip="{Binding Activity.MetadataDetail}" AutomationProperties.Name="{x:Static r:Strings.Status_Metadata}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding Activity.MetadataKind, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=Fill}" />
                    <TextBlock Grid.Column="1" Margin="8,0,10,0" FontSize="12" FontWeight="Medium" Text="{x:Static r:Strings.Status_Metadata}" />
                    <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding Activity.MetadataText}" />
                  </Grid>
                  <ProgressBar Height="3" MinHeight="3" IsIndeterminate="True" IsVisible="{Binding Activity.MetadataRunning}" />
                </StackPanel>
              </Button>

              <ItemsControl ItemsSource="{Binding DestinationsStatus.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarDestinationViewModel">
                    <Button Classes="status-line" Command="{Binding OpenCommand}"
                            ToolTip.Tip="{Binding StatusText}" AutomationProperties.Name="{Binding Name}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                   Fill="{Binding Kind, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=Fill}" />
                          <TextBlock Grid.Column="1" Margin="8,0,10,0" FontSize="12" FontWeight="Medium"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding StatusText}" />
                        </Grid>
                        <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                                     IsVisible="{Binding IsRunning}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                   AutomationProperties.Name="{x:Static r:Strings.Nav_Main}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:StrokeIcon Data="{Binding Page, Converter={x:Static conv:NavIconConverter.Instance}}" />
                  <TextBlock Grid.Column="1" Classes="nav-label" Margin="12,0" VerticalAlignment="Center"
                             Text="{Binding Label}" />
                  <TextBlock Grid.Column="2" Classes="mono muted" FontSize="12" VerticalAlignment="Center"
                             Text="{Binding Count}" IsVisible="{Binding HasPlainCount}" />
                  <Border Grid.Column="2" Classes="nav-badge" Classes.review="{Binding IsReviewBadge}"
                          VerticalAlignment="Center" IsVisible="{Binding HasBadge}">
                    <TextBlock Text="{Binding Count}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Panel>
    </Border>

    <!-- Decorative halftone at the top right of the page area, behind the page (the Library's detail
         panel covers it and draws its own) -->
    <Border Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
      <Border Classes="halftone main" />
    </Border>

    <!-- Current page, with the Kindle notice on top when one is connected with books ready -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Margin="24,16,24,0" Padding="16,10" CornerRadius="{StaticResource RadiusCard}" IsVisible="{Binding ShowKindleBanner}"
              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="{StaticResource BorderControl}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <c:StrokeIcon Data="{StaticResource Icon.BookOpen}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentTextBrush}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding KindleBannerText}" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="primary" MinHeight="34" Margin="12,0,8,0" Content="{x:Static r:Strings.Shell_KindleSend}"
                  Command="{Binding SendToKindleCommand}" />
          <Button Grid.Column="3" Classes="secondary" MinHeight="34" Content="{x:Static r:Strings.Shell_KindleLater}"
                  Command="{Binding DismissKindleCommand}" />
        </Grid>
      </Border>
      <!-- A new version (F6) -->
      <Border DockPanel.Dock="Top" Margin="24,16,24,0" Padding="16,10" CornerRadius="{StaticResource RadiusCard}" IsVisible="{Binding Update.ShowBanner}"
              Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="{StaticResource BorderControl}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <c:StrokeIcon Data="{StaticResource Icon.Import}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding Update.BannerText}" TextWrapping="Wrap" />
            <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Update.Progress}" IsVisible="{Binding Update.IsDownloading}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="primary" MinHeight="34" Margin="12,0,8,0" Content="{x:Static r:Strings.Update_Install}"
                  Command="{Binding Update.InstallCommand}" />
          <Button Grid.Column="3" Classes="secondary" MinHeight="34" Content="{x:Static r:Strings.Update_Later}"
                  Command="{Binding Update.DismissCommand}" />
        </Grid>
      </Border>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
  </Grid>
</UserControl>
