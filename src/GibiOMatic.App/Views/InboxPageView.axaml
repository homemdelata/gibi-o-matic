<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GibiOMatic.App.ViewModels"
             xmlns:c="using:GibiOMatic.App.Controls"
             xmlns:conv="using:GibiOMatic.App.Converters"
             xmlns:r="using:GibiOMatic.App.Resources"
             x:Class="GibiOMatic.App.Views.InboxPageView"
             x:DataType="vm:InboxPageViewModel"
             c:FileDrop.Command="{Binding DropFilesCommand}">
  <DockPanel Margin="{StaticResource PagePadding}">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,22">
      <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock Classes="h1" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary" Margin="0,0,10,0" Command="{Binding AddFolderCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:StrokeIcon Data="{StaticResource Icon.FolderOpen}" Width="17" Height="17" />
          <TextBlock Text="{x:Static r:Strings.Inbox_AddFolder}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="secondary" Command="{Binding AddFilesCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:StrokeIcon Data="{StaticResource Icon.Import}" Width="17" Height="17" />
          <TextBlock Text="{x:Static r:Strings.Inbox_AddFiles}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Watched folder (F5) -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14" Padding="18,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:StrokeIcon Data="{StaticResource Icon.FolderOpen}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,14,0"
                      Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsWatching}" />
        <c:StrokeIcon Data="{StaticResource Icon.FolderOpen}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,14,0"
                      Foreground="{DynamicResource OffBrush}" IsVisible="{Binding !IsWatching}" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="{Binding WatchTitle}" />
          <TextBlock Classes="mono" FontSize="12.5" Text="{Binding WatchFolder}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding IsWatching}" ToolTip.Tip="{Binding WatchFolder}" />
          <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{Binding WatchText}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="secondary" Margin="16,0,0,0" VerticalAlignment="Center"
                Content="{x:Static r:Strings.Inbox_WatchConfigure}" Command="{Binding ConfigureInboxCommand}" />
      </Grid>
    </Border>

    <!-- Drop zone -->
    <Panel DockPanel.Dock="Top" Margin="0,0,0,22">
      <Rectangle Classes="dropzone" StrokeThickness="2" StrokeDashArray="4,3" RadiusX="14" RadiusY="14" />
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="22,18">
        <c:StrokeIcon Data="{StaticResource Icon.Import}" Width="26" Height="26" Foreground="{DynamicResource AccentTextBrush}"
                      VerticalAlignment="Center" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="{x:Static r:Strings.Inbox_DropTitle}" />
          <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{x:Static r:Strings.Inbox_DropHelp}" />
        </StackPanel>
      </StackPanel>
    </Panel>

    <!-- Background work -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16" Padding="16,12"
            IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="mono" FontSize="12.5" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue}" IsVisible="{Binding IsWorking}" Height="4"
                       Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HoverBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Margin="16,0,0,0" MinHeight="38" Command="{Binding TogglePauseCommand}"
                Content="{Binding PauseLabel}" />
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" Classes="success" Margin="0,0,0,16" Text="{Binding DoneSummary}"
               IsVisible="{Binding DoneSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TextBlock DockPanel.Dock="Top" Classes="section-label" Margin="0,0,0,12" Text="{Binding ListHeader}"
               IsVisible="{Binding HasItems}" />

    <!-- Footer -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,0" IsVisible="{Binding HasItems}">
      <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Text="{Binding ConfirmSummary}" />
      <Button Grid.Column="1" Classes="secondary" Margin="0,0,10,0" Content="{x:Static r:Strings.Inbox_ClearFinished}"
              Command="{Binding ClearFinishedCommand}" />
      <Button Grid.Column="2" Classes="secondary" Margin="0,0,10,0" Content="{x:Static r:Strings.Inbox_SkipAll}"
              Command="{Binding SkipAllCommand}" />
      <Button Grid.Column="3" Classes="primary" Padding="22,0" Content="{x:Static r:Strings.Inbox_Import}"
              Command="{Binding ImportCommand}" />
    </Grid>

    <!-- Files -->
    <ListBox Classes="inbox" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}" Background="Transparent"
             AutomationProperties.Name="{x:Static r:Strings.Inbox_Files}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,12" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:InboxItemViewModel">
          <Border Classes="card" Padding="16,14">
            <Grid ColumnDefinitions="2*,Auto,3*,Auto">
              <!-- What arrived -->
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Border Classes="format-chip">
                  <TextBlock Classes="mono" FontSize="11" Text="{Binding FormatLabel}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Classes="mono" FontSize="13" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding SourcePath}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding SizeText}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{x:Static r:Strings.Inbox_AutoChip}" IsVisible="{Binding IsAuto}"
                               Foreground="{DynamicResource AccentTextBrush}" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <c:StrokeIcon Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Margin="18,0" VerticalAlignment="Center"
                            Foreground="{DynamicResource OffBrush}" />

              <!-- What it becomes -->
              <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Border Width="40" Height="60" CornerRadius="5" ClipToBounds="True" VerticalAlignment="Top"
                        Background="{DynamicResource HoverBrush}">
                  <Panel>
                    <Border Background="{StaticResource HalftoneBrush}" />
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="muted" FontSize="12.5" Text="{Binding MetaLine}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding MetaLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock FontSize="12.5" Foreground="{DynamicResource WarnTextBrush}" Text="{Binding NoteLine}" TextWrapping="Wrap"
                             IsVisible="{Binding NoteLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Border HorizontalAlignment="Left" Margin="0,6,0,0" BorderBrush="{DynamicResource BorderStrongBrush}"
                          BorderThickness="1" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasDecisions}">
                    <ItemsControl ItemsSource="{Binding Decisions}" AutomationProperties.Name="{x:Static r:Strings.Inbox_Decisions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DecisionOptionViewModel">
                          <Button Classes="segment decision" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                                  Command="{Binding PickCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- Status -->
              <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6" MinWidth="150">
                <Border Classes="pill" HorizontalAlignment="Right"
                        Background="{Binding StatusKind, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=Background}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="260"
                             Foreground="{Binding StatusKind, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
                </Border>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, FallbackValue=0}" Height="3"
                             IsVisible="{Binding Progress, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HoverBrush}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
