<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GibiOMatic.App.ViewModels"
             xmlns:c="using:GibiOMatic.App.Controls"
             xmlns:r="using:GibiOMatic.App.Resources"
             x:Class="GibiOMatic.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
  <DockPanel Margin="{StaticResource PagePadding}" MaxWidth="980" HorizontalAlignment="Left">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="h1" Text="{Binding Title}" />
        <c:TitleMark />
      </StackPanel>
      <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="14">
      <TextBlock Classes="success" Text="{Binding StatusMessage}" IsVisible="{Binding !StatusIsError}" />
      <TextBlock Classes="error" Text="{Binding StatusMessage}" IsVisible="{Binding StatusIsError}" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Classes="secondary" Content="{x:Static r:Strings.Settings_RestoreDefaults}"
                Command="{Binding RestoreDefaultsCommand}" />
        <Button Classes="primary" Padding="22,0" Content="{x:Static r:Strings.Settings_Save}"
                Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>

    <TabControl Classes="sections">
      <!-- Folders -->
      <TabItem Header="{x:Static r:Strings.Settings_TabFolders}">
        <StackPanel Spacing="14">
          <Border Classes="card">
            <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.RowSpan="2" Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_LibraryLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_LibraryHelp}" />
              </StackPanel>
              <TextBox Grid.Column="1" Classes="mono" IsReadOnly="True" Text="{Binding LibraryPath}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_LibraryLabel}" />
              <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button Classes="secondary" MinHeight="42" Padding="14,0" Command="{Binding OpenOtherLibraryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:StrokeIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                    <TextBlock Text="{x:Static r:Strings.Settings_OpenOther}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="secondary" MinHeight="42" Padding="14,0" Command="{Binding RebuildIndexCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:StrokeIcon Data="{StaticResource Icon.Rebuild}" Width="16" Height="16" />
                    <TextBlock Text="{x:Static r:Strings.Settings_RebuildIndex}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_InboxLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_InboxHelp}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox Classes="mono" Text="{Binding InboxPath}"
                         AutomationProperties.Name="{x:Static r:Strings.Settings_InboxLabel}" />
                <Button Grid.Column="1" Classes="secondary" MinHeight="42" Padding="14,0" Margin="8,0,0,0"
                        FontWeight="Normal" Content="{x:Static r:Strings.Common_Choose}"
                        Command="{Binding ChooseInboxCommand}" />
              </Grid>
            </Grid>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_AfterImportLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_AfterImportHelp}" />
              </StackPanel>
              <ComboBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AfterImportOptions}" SelectedItem="{Binding SelectedAfterImport}"
                        AutomationProperties.Name="{x:Static r:Strings.Settings_AfterImportLabel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AfterImportOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Metadata -->
      <TabItem Header="{x:Static r:Strings.Settings_TabMetadata}">
        <StackPanel Spacing="14">
          <TextBlock Classes="help" FontSize="13" Text="{x:Static r:Strings.Settings_SourcesHelp}" />
          <ItemsControl ItemsSource="{Binding Sources}" AutomationProperties.Name="{x:Static r:Strings.Settings_TabMetadata}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceOptionViewModel">
                <Border Classes="card" Margin="0,0,0,10">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="28,*,Auto,Auto,Auto">
                      <TextBlock Classes="mono muted" VerticalAlignment="Center" Text="{Binding Position}" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="strong" Text="{Binding Name}" />
                        <TextBlock Classes="help" Text="{Binding Help}" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="icon" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).MoveSourceUpCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{x:Static r:Strings.Settings_MoveUp}"
                              AutomationProperties.Name="{x:Static r:Strings.Settings_MoveUp}">
                        <c:StrokeIcon Data="{StaticResource Icon.ChevronUp}" Width="16" Height="16" />
                      </Button>
                      <Button Grid.Column="3" Classes="icon" Margin="0,0,14,0"
                              Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).MoveSourceDownCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{x:Static r:Strings.Settings_MoveDown}"
                              AutomationProperties.Name="{x:Static r:Strings.Settings_MoveDown}">
                        <c:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Width="16" Height="16" />
                      </Button>
                      <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}" OnContent="" OffContent=""
                                    AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding NeedsKey}" Margin="28,0,0,0">
                      <TextBlock Classes="field-label" Text="{x:Static r:Strings.Settings_KeyLabel}" />
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox Classes="mono" PasswordChar="•" PlaceholderText="{x:Static r:Strings.Settings_KeyPlaceholder}"
                                 Text="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).ComicVineKeyInput}"
                                 IsEnabled="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).CanStoreSecrets}"
                                 AutomationProperties.Name="{x:Static r:Strings.Settings_KeyLabel}" />
                        <Button Grid.Column="1" Classes="secondary" Margin="8,0,0,0" Content="{x:Static r:Strings.Settings_SaveKey}"
                                Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).SaveKeyCommand}" />
                        <Button Grid.Column="2" Classes="secondary" Margin="8,0,0,0" Content="{x:Static r:Strings.Settings_TestKey}"
                                Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).TestKeyCommand}" />
                        <Button Grid.Column="3" Classes="secondary" Margin="8,0,0,0" Content="{x:Static r:Strings.Settings_RemoveKey}"
                                Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).RemoveKeyCommand}" />
                      </Grid>
                      <TextBlock Classes="help" Text="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).KeyStatus}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_KeyHelp}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card">
            <StackPanel Spacing="4">
              <CheckBox Content="{x:Static r:Strings.Settings_AlwaysReview}" IsChecked="{Binding AlwaysReview}" FontWeight="SemiBold" />
              <TextBlock Classes="help" Margin="28,0,0,0" Text="{x:Static r:Strings.Settings_AlwaysReviewHelp}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- General -->
      <TabItem Header="{x:Static r:Strings.Settings_TabGeneral}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,12,0">
          <Grid ColumnDefinitions="*,14,*">
            <StackPanel Spacing="6">
              <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_Language}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        AutomationProperties.Name="{x:Static r:Strings.Settings_Language}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_Theme}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                        AutomationProperties.Name="{x:Static r:Strings.Settings_Theme}">
                <ComboBox.Styles>
                  <Style Selector="ComboBoxItem" x:DataType="vm:ThemeOption">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                  </Style>
                </ComboBox.Styles>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <TextBlock Classes="help" FontSize="13" Foreground="{DynamicResource WarnTextBrush}"
                     Text="{x:Static r:Strings.Settings_RestartNotice}" IsVisible="{Binding RestartRequired}" />

          <Border Classes="card" Margin="0,8,0,0">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_FormatsLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_FormatsHelp}" />
              </StackPanel>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Formats}" HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Static r:Strings.Settings_FormatsLabel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FormatOption">
                    <Grid ColumnDefinitions="28,72,Auto,Auto" Margin="0,0,0,8">
                      <TextBlock Classes="mono muted" VerticalAlignment="Center" Text="{Binding Rank}" />
                      <Border Grid.Column="1" Classes="format-chip" HorizontalAlignment="Left" Padding="10,4">
                        <TextBlock Classes="mono" Text="{Binding Label}" />
                      </Border>
                      <Button Grid.Column="2" Classes="icon" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).MoveFormatUpCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{x:Static r:Strings.Settings_MoveUp}"
                              ToolTip.Tip="{x:Static r:Strings.Settings_MoveUp}">
                        <c:StrokeIcon Data="{StaticResource Icon.ChevronUp}" Width="16" Height="16" />
                      </Button>
                      <Button Grid.Column="3" Classes="icon"
                              Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).MoveFormatDownCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{x:Static r:Strings.Settings_MoveDown}"
                              ToolTip.Tip="{x:Static r:Strings.Settings_MoveDown}">
                        <c:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Width="16" Height="16" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- Version and updates (F6) -->
          <Border Classes="card">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Update_Label}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Update_Help}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Classes="mono" Text="{Binding Update.VersionText}" />
                <TextBlock Classes="help" Text="{Binding Update.StatusText}" IsVisible="{Binding !Update.StatusIsError}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Classes="error" Text="{Binding Update.StatusText}" IsVisible="{Binding Update.StatusIsError}" />
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Update.Progress}" IsVisible="{Binding Update.IsDownloading}" />
                <CheckBox Content="{x:Static r:Strings.Update_Automatic}" IsChecked="{Binding CheckForUpdates}" FontWeight="SemiBold"
                          IsVisible="{Binding Update.IsSupported}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Update.IsSupported}">
                  <Button Classes="secondary" Content="{x:Static r:Strings.Update_Check}" Command="{Binding Update.CheckCommand}" />
                  <Button Classes="primary" Content="{x:Static r:Strings.Update_Install}" Command="{Binding Update.InstallCommand}"
                          IsVisible="{Binding Update.CanInstall}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Background (F5) -->
          <Border Classes="card" IsVisible="{Binding TraySupported}">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_BackgroundLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_BackgroundHelp}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="14">
                <StackPanel Spacing="4">
                  <CheckBox Content="{x:Static r:Strings.Settings_CloseToTray}" IsChecked="{Binding CloseToTray}" FontWeight="SemiBold" />
                  <TextBlock Classes="help" Margin="28,0,0,0" Text="{x:Static r:Strings.Settings_CloseToTrayHelp}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding StartupSupported}">
                  <CheckBox Content="{Binding StartWithSystemLabel}" IsChecked="{Binding StartWithSystem}" FontWeight="SemiBold" />
                  <StackPanel Spacing="4" Margin="28,0,0,0" IsVisible="{Binding StartWithSystem}">
                    <RadioButton GroupName="StartMode" Content="{x:Static r:Strings.Settings_StartInTray}" IsChecked="{Binding StartInTray}" />
                    <RadioButton GroupName="StartMode" Content="{x:Static r:Strings.Settings_StartWithWindow}" IsChecked="{Binding StartWithWindow}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
