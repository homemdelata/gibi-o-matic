<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GibiOMatic.App.ViewModels"
             xmlns:c="using:GibiOMatic.App.Controls"
             xmlns:r="using:GibiOMatic.App.Resources"
             x:Class="GibiOMatic.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
  <DockPanel Margin="{StaticResource PagePadding}" MaxWidth="980" HorizontalAlignment="Left">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="14">
      <TextBlock Classes="success" Text="{Binding StatusMessage}" IsVisible="{Binding !StatusIsError}" />
      <TextBlock Classes="error" Text="{Binding StatusMessage}" IsVisible="{Binding StatusIsError}" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Classes="secondary" Content="{x:Static r:Strings.Settings_RestoreDefaults}"
                Command="{Binding RestoreDefaultsCommand}" />
        <Button Classes="primary" Padding="22,0" Content="{x:Static r:Strings.Settings_Save}"
                Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>

    <TabControl Classes="sections">
      <!-- Folders -->
      <TabItem Header="{x:Static r:Strings.Settings_TabFolders}">
        <StackPanel Spacing="14">
          <Border Classes="card">
            <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.RowSpan="2" Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_LibraryLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_LibraryHelp}" />
              </StackPanel>
              <TextBox Grid.Column="1" Classes="mono" IsReadOnly="True" Text="{Binding LibraryPath}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_LibraryLabel}" />
              <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button Classes="secondary" MinHeight="42" Padding="14,0" Command="{Binding OpenOtherLibraryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:StrokeIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                    <TextBlock Text="{x:Static r:Strings.Settings_OpenOther}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="secondary" MinHeight="42" Padding="14,0" Command="{Binding RebuildIndexCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:StrokeIcon Data="{StaticResource Icon.Rebuild}" Width="16" Height="16" />
                    <TextBlock Text="{x:Static r:Strings.Settings_RebuildIndex}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_InboxLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_InboxHelp}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox Classes="mono" Text="{Binding InboxPath}"
                         AutomationProperties.Name="{x:Static r:Strings.Settings_InboxLabel}" />
                <Button Grid.Column="1" Classes="secondary" MinHeight="42" Padding="14,0" Margin="8,0,0,0"
                        FontWeight="Normal" Content="{x:Static r:Strings.Common_Choose}"
                        Command="{Binding ChooseInboxCommand}" />
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- General -->
      <TabItem Header="{x:Static r:Strings.Settings_TabGeneral}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,14,*">
            <StackPanel Spacing="6">
              <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_Language}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        AutomationProperties.Name="{x:Static r:Strings.Settings_Language}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_Theme}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                        AutomationProperties.Name="{x:Static r:Strings.Settings_Theme}">
                <ComboBox.Styles>
                  <Style Selector="ComboBoxItem" x:DataType="vm:ThemeOption">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                  </Style>
                </ComboBox.Styles>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <TextBlock Classes="help" FontSize="13" Foreground="{DynamicResource WarnTextBrush}"
                     Text="{x:Static r:Strings.Settings_RestartNotice}" IsVisible="{Binding RestartRequired}" />

          <Border Classes="card" Margin="0,8,0,0">
            <Grid ColumnDefinitions="260,*">
              <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Classes="strong" Text="{x:Static r:Strings.Settings_FormatsLabel}" />
                <TextBlock Classes="help" Text="{x:Static r:Strings.Settings_FormatsHelp}" />
              </StackPanel>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Formats}" HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Static r:Strings.Settings_FormatsLabel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FormatOption">
                    <Grid ColumnDefinitions="28,72,Auto,Auto" Margin="0,0,0,8">
                      <TextBlock Classes="mono muted" VerticalAlignment="Center" Text="{Binding Rank}" />
                      <Border Grid.Column="1" Classes="format-chip" HorizontalAlignment="Left" Padding="10,4">
                        <TextBlock Classes="mono" Text="{Binding Label}" />
                      </Border>
                      <Button Grid.Column="2" Classes="icon" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).MoveFormatUpCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{x:Static r:Strings.Settings_MoveUp}"
                              ToolTip.Tip="{x:Static r:Strings.Settings_MoveUp}">
                        <c:StrokeIcon Data="{StaticResource Icon.ChevronUp}" Width="16" Height="16" />
                      </Button>
                      <Button Grid.Column="3" Classes="icon"
                              Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).MoveFormatDownCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{x:Static r:Strings.Settings_MoveDown}"
                              ToolTip.Tip="{x:Static r:Strings.Settings_MoveDown}">
                        <c:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Width="16" Height="16" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
