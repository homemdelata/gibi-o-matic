<!--
  Design tokens from docs/DESIGN.md. Colors live in theme dictionaries so the light theme (F6)
  is just another dictionary with the same keys. Always reference colors with DynamicResource.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgColor">#121317</Color>
      <Color x:Key="SurfaceColor">#17181D</Color>
      <Color x:Key="CardColor">#1A1B21</Color>
      <Color x:Key="InputColor">#1D1F25</Color>
      <Color x:Key="HoverColor">#262931</Color>
      <Color x:Key="BorderColor">#262931</Color>
      <Color x:Key="BorderStrongColor">#2E313A</Color>
      <Color x:Key="TextColor">#ECEDEF</Color>
      <Color x:Key="TextSecondaryColor">#C9CCD3</Color>
      <Color x:Key="TextMutedColor">#A3A8B3</Color>
      <Color x:Key="TextFaintColor">#8C919C</Color>
      <Color x:Key="AccentColor">#F5C542</Color>
      <Color x:Key="AccentHoverColor">#FFD970</Color>
      <Color x:Key="OnAccentColor">#17181D</Color>
      <Color x:Key="OkColor">#4CC38A</Color>
      <Color x:Key="OkTextColor">#6FD9A5</Color>
      <Color x:Key="WarnColor">#F08A4B</Color>
      <Color x:Key="WarnTextColor">#F5A574</Color>
      <Color x:Key="BadColor">#F2677A</Color>
      <Color x:Key="OffColor">#5B606B</Color>

      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
      <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
      <SolidColorBrush x:Key="OkTextBrush" Color="{StaticResource OkTextColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="WarnTextBrush" Color="{StaticResource WarnTextColor}" />
      <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
      <SolidColorBrush x:Key="OffBrush" Color="{StaticResource OffColor}" />

      <!-- Fluent theme overrides so stock controls follow the tokens. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource TextFaintColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextFaintColor}" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#66F5C542" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource InputColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource HoverColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource TextFaintColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource HoverColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource HoverColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource BorderStrongColor}" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource AccentColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Typography -->
  <FontFamily x:Key="FontDisplay">avares://GibiOMatic/Assets/Fonts#Bricolage Grotesque</FontFamily>
  <FontFamily x:Key="FontText">avares://GibiOMatic/Assets/Fonts#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="FontMono">avares://GibiOMatic/Assets/Fonts#IBM Plex Mono</FontFamily>

  <!-- Shape -->
  <CornerRadius x:Key="RadiusControl">10</CornerRadius>
  <CornerRadius x:Key="RadiusField">9</CornerRadius>
  <CornerRadius x:Key="RadiusCard">14</CornerRadius>
  <CornerRadius x:Key="RadiusCardLarge">16</CornerRadius>
  <CornerRadius x:Key="RadiusPill">99</CornerRadius>
  <CornerRadius x:Key="RadiusCover">10</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

  <!-- Space (4 px base) -->
  <x:Double x:Key="ControlHeight">44</x:Double>
  <x:Double x:Key="SidebarWidth">248</x:Double>
  <Thickness x:Key="PagePadding">32,28</Thickness>
  <Thickness x:Key="CardPadding">18,16</Thickness>
</ResourceDictionary>
