<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GibiOMatic.App.ViewModels"
             xmlns:v="using:GibiOMatic.App.Views"
             x:Class="GibiOMatic.App.App"
             Name="Gibi-o-matic"
             RequestedThemeVariant="Dark">
  <!-- The theme of the settings is applied at start (App.axaml.cs). -->

  <Application.DataTemplates>
    <DataTemplate DataType="vm:WelcomeViewModel"><v:WelcomeView /></DataTemplate>
    <DataTemplate DataType="vm:LibraryOpeningViewModel"><v:LibraryOpeningView /></DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel"><v:ShellView /></DataTemplate>
    <DataTemplate DataType="vm:LibraryPageViewModel"><v:LibraryPageView /></DataTemplate>
    <DataTemplate DataType="vm:InboxPageViewModel"><v:InboxPageView /></DataTemplate>
    <DataTemplate DataType="vm:ReviewPageViewModel"><v:ReviewPageView /></DataTemplate>
    <DataTemplate DataType="vm:EditorPageViewModel"><v:EditorPageView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel"><v:SettingsPageView /></DataTemplate>
    <DataTemplate DataType="vm:DestinationsPageViewModel"><v:DestinationsPageView /></DataTemplate>
    <DataTemplate DataType="vm:PlaceholderPageViewModel"><v:PlaceholderPageView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <ResourceInclude Source="/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFF27A" RegionColor="#060B1C" AltHigh="#060B1C"
                               BaseHigh="#F1F4FA" ErrorText="#FF6FB0" />
        <ColorPaletteResources x:Key="Light" Accent="#145E92" RegionColor="#F4EEDD" AltHigh="#F4EEDD"
                               BaseHigh="#0B1630" ErrorText="#A3134D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
